{
  "name": "php-upgrade-preflight/cli",
  "description": "Generic CLI for PHP Upgrade Preflight.",
  "type": "library",
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "cli",
    "composer",
    "dependency-analysis",
    "php",
    "upgrade"
  ],
  "homepage": "https://github.com/ValentinNikolaev/php-upgrade-preflight",
  "authors": [
    {
      "name": "Valentin Nikolaev"
    }
  ],
  "support": {
    "issues": "https://github.com/ValentinNikolaev/php-upgrade-preflight/issues",
    "source": "https://github.com/ValentinNikolaev/php-upgrade-preflight/tree/main/packages/cli"
  },
  "require": {
    "composer-runtime-api": "^2.0",
    "php": "^8.0",
    "php-upgrade-preflight/core": "^0.2"
  },
  "suggest": {
    "php-upgrade-preflight/laravel": "Enables Laravel detection and the --framework=laravel rule pack in generic CLI mode."
  },
  "autoload": {
    "psr-4": {
      "PhpUpgradePreflight\\Cli\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhpUpgradePreflight\\Cli\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/upgrade-intel"
  ],
  "extra": {
    "branch-alias": {
      "dev-main": "0.2.x-dev"
    }
  }
}
